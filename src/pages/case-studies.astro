---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';

const caseStudies = [
  {
    company: "Global Technology Leader",
    industry: "Technology",
    challenge: "Rapid headcount growth from 2,000 to 5,500 employees created a critical leadership gap across 12 regions.",
    solution: "Deployed 65 coaches over 8 months. Built a custom leadership competency framework and cohort-based development program for 200+ new managers.",
    results: ["34% improvement in manager effectiveness scores", "27% reduction in new-manager attrition", "Time-to-productivity decreased by 6 weeks", "Promoted 45 leaders from within (vs. external hires)"],
    coachCount: 65,
    duration: "8 months",
    tags: ["Leadership", "Scale-up", "Global"],
  },
  {
    company: "Fortune 200 Financial Services",
    industry: "Financial Services",
    challenge: "Post-merger integration created cultural friction between two legacy organizations, impacting collaboration and client satisfaction.",
    solution: "Embedded 40 transition coaches across both organizations. Facilitated cultural alignment workshops and individual coaching for 300 senior leaders.",
    results: ["23% improvement in cross-team collaboration scores", "Client NPS recovered to pre-merger levels", "Voluntary attrition dropped 18% in target cohort", "Unified leadership competency model adopted"],
    coachCount: 40,
    duration: "12 months",
    tags: ["M&A", "Culture", "Financial Services"],
  },
  {
    company: "Healthcare Systems Network",
    industry: "Healthcare",
    challenge: "Physician and nursing leadership burnout at crisis levels following pandemic pressures, impacting patient outcomes and staff retention.",
    solution: "Designed a wellness-integrated coaching program for 150 clinical leaders. Combined traditional coaching with resilience training and peer support circles.",
    results: ["41% reduction in burnout indicators", "Staff retention improved 22%", "Patient satisfaction scores up 15%", "Program now permanent part of L&D budget"],
    coachCount: 30,
    duration: "6 months",
    tags: ["Healthcare", "Wellness", "Retention"],
  },
  {
    company: "Enterprise SaaS Platform",
    industry: "Technology",
    challenge: "Series D startup needed to professionalize its leadership as it scaled from 200 to 1,200 employees across 5 countries.",
    solution: "Provided 25 executive and team coaches, established a leadership academy, and created a mentorship matching program.",
    results: ["Leadership bench strength increased 3x", "Internal promotion rate doubled", "Reduced executive hiring costs by $2.1M", "95% coaching satisfaction rating"],
    coachCount: 25,
    duration: "10 months",
    tags: ["Scale-up", "SaaS", "Leadership Academy"],
  },
];
---

<BaseLayout title="Case Studies" description="See how Dragon Team has deployed coaching at scale for Fortune 500 companies, healthcare systems, and high-growth startups.">

  <section class="page-hero section--hero bg-grid bg-radial" id="cases-hero">
    <div class="container">
      <span class="badge animate-fade-in-up">Proof of Impact</span>
      <h1 class="animate-fade-in-up stagger-1">Client <span class="gradient-text">Success Stories</span></h1>
      <p class="page-hero__desc animate-fade-in-up stagger-2">
        Real results from real engagements. See how we've deployed coaching teams at scale to deliver measurable business outcomes.
      </p>
    </div>
  </section>

  <section class="cases section" id="case-studies-list">
    <div class="container">
      {caseStudies.map((cs, i) => (
        <article class={`case animate-fade-in-up stagger-${(i % 4) + 1}`} id={`case-study-${i}`}>
          <div class="case__header">
            <div>
              <span class="case__industry">{cs.industry}</span>
              <h2 class="case__title">{cs.company}</h2>
            </div>
            <div class="case__meta">
              <div class="case__meta-item">
                <span class="case__meta-value">{cs.coachCount}</span>
                <span class="case__meta-label">Coaches</span>
              </div>
              <div class="case__meta-item">
                <span class="case__meta-value">{cs.duration}</span>
                <span class="case__meta-label">Duration</span>
              </div>
            </div>
          </div>

          <div class="case__body">
            <div class="case__section">
              <h4>Challenge</h4>
              <p>{cs.challenge}</p>
            </div>
            <div class="case__section">
              <h4>Solution</h4>
              <p>{cs.solution}</p>
            </div>
            <div class="case__section case__section--results">
              <h4>Results</h4>
              <ul>
                {cs.results.map(r => <li>{r}</li>)}
              </ul>
            </div>
          </div>

          <div class="case__tags">
            {cs.tags.map(tag => <span class="case__tag">{tag}</span>)}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="cta section bg-radial" id="cases-cta">
    <div class="container" style="text-align: center;">
      <h2>Your Organization Could Be Next</h2>
      <p style="max-width: 500px; margin: var(--space-md) auto var(--space-2xl);">
        Let's discuss how a tailored coaching program can deliver similar results for your team.
      </p>
      <a href="/contact" class="btn btn--primary btn--large" id="cases-cta-btn">Start Your Story</a>
    </div>
  </section>
</BaseLayout>


<style>
  .page-hero {
    text-align: center;
    padding-bottom: var(--space-3xl);
  }

  .page-hero h1 {
    margin-top: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .page-hero__desc {
    max-width: 620px;
    margin: 0 auto;
    font-size: 1.15rem;
  }

  .case {
    padding: var(--space-2xl);
    background: var(--dt-surface);
    border: 1px solid var(--dt-border);
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-xl);
    transition: border-color var(--duration-normal) var(--ease-out);
  }

  .case:hover {
    border-color: var(--dt-border-active);
  }

  .case__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-xl);
    margin-bottom: var(--space-xl);
    flex-wrap: wrap;
  }

  .case__industry {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--dt-gold);
    margin-bottom: 4px;
    display: block;
  }

  .case__title {
    font-size: 1.5rem;
  }

  .case__meta {
    display: flex;
    gap: var(--space-xl);
  }

  .case__meta-item {
    text-align: center;
  }

  .case__meta-value {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--dt-gold);
    display: block;
  }

  .case__meta-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--dt-text-muted);
  }

  .case__body {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: var(--space-xl);
    margin-bottom: var(--space-lg);
  }

  .case__section h4 {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--dt-text-muted);
    margin-bottom: var(--space-sm);
  }

  .case__section p {
    font-size: 0.9rem;
  }

  .case__section--results ul {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .case__section--results li {
    font-size: 0.85rem;
    color: var(--dt-success);
    font-weight: 500;
    padding-left: 1.2rem;
    position: relative;
  }

  .case__section--results li::before {
    content: '✓';
    position: absolute;
    left: 0;
    font-size: 0.75rem;
  }

  .case__tags {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .case__tag {
    font-size: 0.7rem;
    padding: 3px 10px;
    border-radius: var(--radius-full);
    background: var(--dt-surface-hover);
    color: var(--dt-text-muted);
    font-weight: 500;
    border: 1px solid var(--dt-border);
  }

  @media (max-width: 768px) {
    .case__body {
      grid-template-columns: 1fr;
    }

    .case__header {
      flex-direction: column;
    }
  }
</style>
