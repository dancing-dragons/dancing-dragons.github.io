---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
---

<BaseLayout title="Enterprise Coaching Partnerships" description="Dragon Team deploys world-class coaching teams into organizations that demand measurable human transformation. ICF-certified coaches for Fortune 500 leadership, EAP integrations, and high-growth team performance.">

  <!-- ═══════════ HERO SECTION ═══════════ -->
  <section class="hero section--hero bg-grid bg-radial" id="hero">
    <div class="container">
      <div class="hero__content">
        <div class="badge animate-fade-in-up">
          <span class="badge__dot"></span>
          Now Accepting Partnership Applications
        </div>

        <h1 class="hero__title animate-fade-in-up stagger-1">
          Human Transformation<br/>
          at <span class="gradient-text">Enterprise Scale</span>
        </h1>

        <p class="hero__subtitle animate-fade-in-up stagger-2">
          We deploy world-class coaching teams into organizations that demand measurable impact.
          Precision-matched ICF coaches for Fortune 500 leadership, high-growth teams, and
          the people who power them — available in days, not months.
        </p>

        <div class="hero__actions animate-fade-in-up stagger-3">
          <a href="/contact" class="btn btn--primary btn--large" id="hero-cta-primary">
            Explore a Partnership
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <a href="/case-studies" class="btn btn--secondary btn--large" id="hero-cta-secondary">
            View Case Studies
          </a>
        </div>

        <div class="hero__proof animate-fade-in-up stagger-4">
          <div class="hero__proof-logos">
            <span class="hero__proof-label">Trusted by teams at</span>
            <div class="hero__proof-grid">
              <span class="hero__proof-company">Salesforce</span>
              <span class="hero__proof-divider">·</span>
              <span class="hero__proof-company">Deloitte</span>
              <span class="hero__proof-divider">·</span>
              <span class="hero__proof-company">McKinsey</span>
              <span class="hero__proof-divider">·</span>
              <span class="hero__proof-company">JPMorgan</span>
              <span class="hero__proof-divider">·</span>
              <span class="hero__proof-company">Google</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Decorative orbs -->
    <div class="hero__orb" aria-hidden="true"></div>
    <div class="hero__orb hero__orb--2" aria-hidden="true"></div>
    <div class="hero__orb hero__orb--3" aria-hidden="true"></div>
  </section>


  <!-- ═══════════ STATS BAR ═══════════ -->
  <section class="stats" id="stats-bar">
    <div class="container">
      <div class="stats__grid">
        <div class="stats__item animate-fade-in-up stagger-1">
          <span class="stats__number">500+</span>
          <span class="stats__label">Coaches Deployed</span>
        </div>
        <div class="stats__item animate-fade-in-up stagger-2">
          <span class="stats__number">80+</span>
          <span class="stats__label">Enterprise Clients</span>
        </div>
        <div class="stats__item animate-fade-in-up stagger-3">
          <span class="stats__number">94%</span>
          <span class="stats__label">Engagement Retention</span>
        </div>
        <div class="stats__item animate-fade-in-up stagger-4">
          <span class="stats__number">3.8x</span>
          <span class="stats__label">Average ROI</span>
        </div>
      </div>
    </div>
  </section>


  <!-- ═══════════ PARTNERSHIP MODELS ═══════════ -->
  <section class="deals section" id="deals-section">
    <div class="container">
      <div class="deals__header">
        <span class="badge animate-fade-in-up">Partnership Models</span>
        <h2 class="animate-fade-in-up stagger-1">Four Ways We <span class="gradient-text">Partner With You</span></h2>
        <p class="deals__desc animate-fade-in-up stagger-2">
          Every organization is different. We've designed four distinct partnership structures
          so you can deploy coaching exactly the way your business needs it.
        </p>
      </div>

      <div class="deals__grid">

        <div class="deals__card animate-fade-in-up stagger-1" id="deal-eap">
          <div class="deals__card-top">
            <div class="deals__icon deals__icon--green">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <div class="deals__tag">EAP Integration</div>
          </div>
          <h3>Employee Wellbeing Program</h3>
          <p>
            Embed Dragon Team coaching directly into your Employee Assistance Program. Employees get
            same-week access to ICF-certified coaches for work-life resilience, burnout prevention,
            leadership transitions, and personal development — all confidential, all measurable.
            Modeled on the precision care approach of leading EAP providers, with hard clinical
            outcomes and aggregate impact dashboards for HR leadership.
          </p>
          <ul class="deals__features">
            <li>Access within 24–48 hours of request</li>
            <li>Anonymous utilization & outcomes reporting</li>
            <li>Integrates with existing benefits portal</li>
            <li>Per-seat or per-engagement pricing</li>
          </ul>
          <a href="/contact" class="btn btn--secondary deals__cta">Learn More →</a>
        </div>

        <div class="deals__card animate-fade-in-up stagger-2" id="deal-embedded">
          <div class="deals__card-top">
            <div class="deals__icon deals__icon--green">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>
            </div>
            <div class="deals__tag deals__tag--featured">Most Common</div>
          </div>
          <h3>Embedded Coaching Teams</h3>
          <p>
            We deploy a dedicated squad of 10 to 100+ coaches directly into your organization — aligned
            to your competency frameworks, integrated with your HRIS, and managed by a Dragon Team
            program director. Think of it as a turnkey coaching department without the overhead.
            Scalable globally, active in under three weeks.
          </p>
          <ul class="deals__features">
            <li>20–100+ coaches matched to your org</li>
            <li>Dedicated Dragon Team program manager</li>
            <li>Custom competency framework alignment</li>
            <li>Real-time analytics & quarterly board reports</li>
          </ul>
          <a href="/contact" class="btn btn--primary deals__cta">Start a Conversation →</a>
        </div>

        <div class="deals__card animate-fade-in-up stagger-3" id="deal-whitelabel">
          <div class="deals__card-top">
            <div class="deals__icon deals__icon--magenta">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
            </div>
            <div class="deals__tag deals__tag--magenta">White Label</div>
          </div>
          <h3>White-Label Coaching Platform</h3>
          <p>
            Offer a fully branded coaching product to your clients or employees — powered entirely
            by Dragon Team's infrastructure, coach network, and measurement framework. Your logo,
            your domain, your client relationship. We handle coach recruitment, credentialing,
            scheduling, and impact analytics behind the scenes. Ideal for HR tech platforms,
            insurance providers, and consultancies.
          </p>
          <ul class="deals__features">
            <li>Full custom branding & white-label portal</li>
            <li>API-first integration with your platform</li>
            <li>Coach recruitment & QA managed by us</li>
            <li>Revenue share or licensing model</li>
          </ul>
          <a href="/contact" class="btn btn--secondary deals__cta">Explore White Label →</a>
        </div>

        <div class="deals__card animate-fade-in-up stagger-4" id="deal-referral">
          <div class="deals__card-top">
            <div class="deals__icon deals__icon--magenta">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 12v8a2 2 0 002 2h12a2 2 0 002-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg>
            </div>
            <div class="deals__tag deals__tag--magenta">Channel Partner</div>
          </div>
          <h3>Referral & Reseller Network</h3>
          <p>
            Join our partner network as a strategic referral source or certified reseller. Consulting
            firms, executive search agencies, and HR advisory practices earn competitive commissions
            on every client they bring to Dragon Team. Reseller partners can bundle our coaching
            services directly into their own service packages at negotiated wholesale rates.
          </p>
          <ul class="deals__features">
            <li>Tiered commission structure (10–20%)</li>
            <li>Co-branded proposals & pitch decks</li>
            <li>Dedicated partner success manager</li>
            <li>Joint go-to-market & co-marketing support</li>
          </ul>
          <a href="/contact" class="btn btn--secondary deals__cta">Become a Partner →</a>
        </div>

      </div>
    </div>
  </section>


  <!-- ═══════════ SERVICES SECTION ═══════════ -->
  <section class="services section bg-noise" id="services-section" style="position: relative;">
    <div class="container" style="position: relative; z-index: 1;">
      <div class="services__header">
        <span class="badge animate-fade-in-up">What We Deliver</span>
        <h2 class="animate-fade-in-up stagger-1">Coaching That Moves<br/><span class="gradient-text">the Needle</span></h2>
        <p class="services__desc animate-fade-in-up stagger-2">
          We don't send coaches and hope for the best. We architect comprehensive coaching ecosystems
          calibrated to your leadership challenges, culture, and growth stage.
        </p>
      </div>

      <div class="services__grid">
        <div class="card services__card animate-fade-in-up stagger-1" id="service-executive">
          <div class="services__icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </div>
          <h3>Executive Coaching</h3>
          <p>One-on-one coaching for C-suite and VP-level leaders. ICF-certified coaches precision-matched to your leadership competency framework and business context.</p>
          <ul class="services__features">
            <li>360° leadership assessments</li>
            <li>Custom development roadmaps</li>
            <li>Quarterly stakeholder impact reviews</li>
          </ul>
        </div>

        <div class="card services__card animate-fade-in-up stagger-2" id="service-team">
          <div class="services__icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>
          </div>
          <h3>Team Performance</h3>
          <p>Embed coaching squads across your organization. From 20 to 100+ coaches deployed globally, with scalable programs designed for rapid activation and measurable cohort outcomes.</p>
          <ul class="services__features">
            <li>Team dynamics & psychological safety</li>
            <li>Cross-functional performance alignment</li>
            <li>Live performance analytics dashboard</li>
          </ul>
        </div>

        <div class="card services__card animate-fade-in-up stagger-3" id="service-leadership">
          <div class="services__icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 3h6a4 4 0 014 4v14a3 3 0 00-3-3H2zM22 3h-6a4 4 0 00-4 4v14a3 3 0 013-3h7z"/></svg>
          </div>
          <h3>Leadership Development</h3>
          <p>Custom curriculum for emerging leaders. From first-time managers to senior directors on the path to the C-suite — cohort-based, data-driven, and tied to promotion velocity.</p>
          <ul class="services__features">
            <li>Cohort-based leadership programs</li>
            <li>Mentorship & peer coaching circles</li>
            <li>Succession planning integration</li>
          </ul>
        </div>

        <div class="card services__card animate-fade-in-up stagger-4" id="service-change">
          <div class="services__icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg>
          </div>
          <h3>Change Management Coaching</h3>
          <p>Navigate M&A, restructuring, and digital transformation with coaching support that reduces friction and accelerates adoption at every layer of your organization.</p>
          <ul class="services__features">
            <li>Leader-readiness transition coaching</li>
            <li>Culture integration programs</li>
            <li>Stakeholder alignment & communication</li>
          </ul>
        </div>
      </div>
    </div>
  </section>


  <!-- ═══════════ HOW IT WORKS ═══════════ -->
  <section class="process section" id="process-section">
    <div class="container">
      <div class="process__header">
        <span class="badge animate-fade-in-up">How It Works</span>
        <h2 class="animate-fade-in-up stagger-1">From Discovery to <span class="gradient-text">Measurable Impact</span></h2>
      </div>

      <div class="process__timeline">
        <div class="process__step animate-fade-in-up stagger-1">
          <div class="process__step-number">01</div>
          <div class="process__step-content">
            <h3>Discovery & Alignment</h3>
            <p>We deep-dive into your organizational challenges, culture, and leadership competency framework to identify the right coaching architecture — and the right partnership model — for your stage of growth.</p>
          </div>
        </div>

        <div class="process__step animate-fade-in-up stagger-2">
          <div class="process__step-number">02</div>
          <div class="process__step-content">
            <h3>Coach Matching & Deployment</h3>
            <p>Our matching system pairs your leaders with ICF-certified coaches based on industry experience, behavioral data, coaching style, and your specific development objectives. Deployed in days, not months.</p>
          </div>
        </div>

        <div class="process__step animate-fade-in-up stagger-3">
          <div class="process__step-number">03</div>
          <div class="process__step-content">
            <h3>Structured Engagement</h3>
            <p>Every engagement follows a proven methodology: bi-weekly sessions, milestone check-ins, and real-time progress tracking through our partner portal. Your program manager keeps everything on track.</p>
          </div>
        </div>

        <div class="process__step animate-fade-in-up stagger-4">
          <div class="process__step-number">04</div>
          <div class="process__step-content">
            <h3>Impact Measurement</h3>
            <p>Quarterly business impact reports with hard metrics: retention rates, engagement scores, promotion velocity, and ROI calculations tied directly to your KPIs and strategic objectives.</p>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- ═══════════ TESTIMONIAL ═══════════ -->
  <section class="testimonial section bg-noise" id="testimonial-section" style="position: relative;">
    <div class="container" style="position: relative; z-index: 1;">
      <div class="testimonial__card animate-fade-in-up">
        <svg class="testimonial__quote" width="48" height="48" viewBox="0 0 24 24" fill="currentColor" opacity="0.15"><path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10H14.017zM0 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10H0z"/></svg>
        <blockquote>
          <p class="testimonial__text">
            "Dragon Team deployed 45 coaches across our global leadership program in under three weeks.
            The impact on our Q3 engagement scores was remarkable — a 23% improvement that directly
            correlated with reduced attrition in our high-performer segment. We've renewed for year two."
          </p>
        </blockquote>
        <div class="testimonial__author">
          <div class="testimonial__avatar">SH</div>
          <div>
            <p class="testimonial__name">Sarah Henderson</p>
            <p class="testimonial__role">VP of People, Fortune 200 Technology Company</p>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- ═══════════ PARTNER CTA ═══════════ -->
  <section class="cta section bg-radial" id="cta-section">
    <div class="container">
      <div class="cta__content animate-fade-in-up">
        <h2>Ready to Scale Your<br/><span class="gradient-text">Coaching Impact?</span></h2>
        <p>
          Whether you need 5 executive coaches or 100 team coaches deployed across regions,
          or a white-label platform for your own clients — we build the infrastructure your
          organization needs to thrive.
        </p>
        <div class="cta__actions">
          <a href="/contact" class="btn btn--primary btn--large" id="cta-partner-btn">
            Start a Conversation
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <a href="/partners" class="btn btn--secondary btn--large" id="cta-partner-program-btn">
            View Partnership Models
          </a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>


<style>
  /* ── Hero ── */
  .hero {
    position: relative;
    overflow: hidden;
    min-height: 88vh;
    display: flex;
    align-items: center;
  }

  .hero__content {
    max-width: 800px;
  }

  .hero__title {
    margin-top: var(--space-xl);
    margin-bottom: var(--space-lg);
  }

  .hero__subtitle {
    font-size: 1.15rem;
    max-width: 640px;
    margin-bottom: var(--space-2xl);
    line-height: 1.75;
  }

  .hero__actions {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
    margin-bottom: var(--space-3xl);
  }

  .badge__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--dt-success);
    display: inline-block;
    animation: pulseGlow 2s ease-in-out infinite;
  }

  .hero__proof-label {
    font-size: 0.8rem;
    color: var(--dt-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 500;
  }

  .hero__proof-grid {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-top: var(--space-sm);
    flex-wrap: wrap;
  }

  .hero__proof-company {
    font-size: 1rem;
    font-weight: 600;
    color: var(--dt-text-muted);
    letter-spacing: 0.02em;
    opacity: 0.5;
  }

  .hero__proof-divider {
    color: var(--dt-text-muted);
    opacity: 0.3;
  }

  .hero__orb {
    position: absolute;
    width: 600px;
    height: 600px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(34, 197, 94, 0.07), transparent 70%);
    top: -15%;
    right: -12%;
    animation: float 8s ease-in-out infinite;
    pointer-events: none;
  }

  .hero__orb--2 {
    width: 350px;
    height: 350px;
    background: radial-gradient(circle, rgba(224, 64, 251, 0.06), transparent 70%);
    bottom: 5%;
    right: 18%;
    top: auto;
    animation-delay: -4s;
  }

  .hero__orb--3 {
    width: 250px;
    height: 250px;
    background: radial-gradient(circle, rgba(34, 197, 94, 0.04), transparent 70%);
    top: 40%;
    left: -8%;
    animation-delay: -2s;
  }

  /* ── Stats ── */
  .stats {
    padding: var(--space-3xl) 0;
    border-top: 1px solid var(--dt-border);
    border-bottom: 1px solid var(--dt-border);
    background: var(--dt-surface);
  }

  .stats__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-xl);
    text-align: center;
  }

  .stats__number {
    font-size: 2.5rem;
    font-weight: 800;
    background: linear-gradient(135deg, var(--dt-green-light), var(--dt-green));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    display: block;
  }

  .stats__label {
    font-size: 0.85rem;
    color: var(--dt-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 500;
    margin-top: var(--space-xs);
    display: block;
  }

  /* ── Partnership Deals ── */
  .deals__header {
    text-align: center;
    margin-bottom: var(--space-3xl);
  }

  .deals__header h2 {
    margin-top: var(--space-md);
  }

  .deals__desc {
    max-width: 620px;
    margin: var(--space-md) auto 0;
  }

  .deals__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-xl);
  }

  .deals__card {
    background: var(--dt-surface);
    border: 1px solid var(--dt-border);
    border-radius: var(--radius-lg);
    padding: var(--space-2xl);
    display: flex;
    flex-direction: column;
    transition: all var(--duration-normal) var(--ease-out);
  }

  .deals__card:hover {
    border-color: var(--dt-border-active);
    box-shadow: var(--shadow-glow);
    transform: translateY(-4px);
  }

  .deals__card:has(.deals__icon--magenta):hover {
    border-color: rgba(224, 64, 251, 0.3);
    box-shadow: var(--shadow-magenta);
  }

  .deals__card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: var(--space-lg);
  }

  .deals__icon {
    width: 50px;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
    border: 1px solid;
    flex-shrink: 0;
  }

  .deals__icon--green {
    background: var(--dt-green-glow);
    color: var(--dt-green);
    border-color: var(--dt-green-border);
  }

  .deals__icon--magenta {
    background: var(--dt-magenta-glow);
    color: var(--dt-magenta);
    border-color: rgba(224, 64, 251, 0.2);
  }

  .deals__tag {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 4px 12px;
    border-radius: var(--radius-full);
    background: var(--dt-green-glow);
    color: var(--dt-green);
    border: 1px solid var(--dt-green-border);
  }

  .deals__tag--featured {
    background: rgba(34, 197, 94, 0.2);
    color: var(--dt-green-light);
    border-color: rgba(34, 197, 94, 0.4);
  }

  .deals__tag--magenta {
    background: var(--dt-magenta-glow);
    color: var(--dt-magenta);
    border: 1px solid rgba(224, 64, 251, 0.2);
  }

  .deals__card h3 {
    font-size: 1.3rem;
    margin-bottom: var(--space-sm);
    color: var(--dt-text-primary);
  }

  .deals__card > p {
    font-size: 0.92rem;
    margin-bottom: var(--space-lg);
    line-height: 1.7;
    flex-grow: 1;
  }

  .deals__features {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: var(--space-xl);
  }

  .deals__features li {
    font-size: 0.85rem;
    color: var(--dt-text-secondary);
