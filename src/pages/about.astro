---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';

const leadership = [
  { name: "Daniel Martinez", role: "Founder & CEO", bio: "Former McKinsey consultant. 15+ years building coaching ecosystems for Fortune 500 companies. ICF-MCC certified.", initials: "DM" },
  { name: "Aisha Patel", role: "VP of Partnerships", bio: "Led enterprise coaching programs at Deloitte and Accenture. Specialist in large-scale coach deployment and partner management.", initials: "AP" },
  { name: "Marcus Chen", role: "Head of Coach Operations", bio: "Built and managed networks of 300+ coaches. Expert in quality assurance, coach matching algorithms, and engagement analytics.", initials: "MC" },
  { name: "Elena Vasquez", role: "Director of Leadership Programs", bio: "Former CHRO. Designs custom leadership development curricula for organizations undergoing rapid scale or transformation.", initials: "EV" },
];

const values = [
  { title: "Measurable Impact", desc: "Every engagement is designed around quantifiable business outcomes. We don't just coach — we prove ROI." },
  { title: "Speed to Deployment", desc: "Our pre-vetted network of 500+ coaches means we can deploy teams of 20–100 coaches in under 3 weeks." },
  { title: "Relentless Quality", desc: "Every coach in our network holds active ICF credentials (PCC minimum). We audit every engagement quarterly." },
  { title: "True Partnership", desc: "We embed into your organization as a strategic partner, not a vendor. Your success metrics are our success metrics." },
];
---

<BaseLayout title="About" description="Meet the Dragon Team leadership. We build strategic coaching partnerships for enterprises that demand measurable results.">

  <section class="page-hero section--hero bg-grid bg-radial" id="about-hero">
    <div class="container">
      <span class="badge animate-fade-in-up">About Dragon Team</span>
      <h1 class="animate-fade-in-up stagger-1">The Enterprise Arm of<br/><span class="gradient-text">Dancing Dragons</span></h1>
      <p class="page-hero__desc animate-fade-in-up stagger-2">
        Dragon Team is the B2B division of Dancing Dragons — purpose-built for corporate partnerships,
        large-scale coach deployments, and enterprise-grade coaching infrastructure.
      </p>
    </div>
  </section>

  <!-- Mission -->
  <section class="mission section" id="mission-section">
    <div class="container">
      <div class="mission__grid">
        <div class="mission__text animate-fade-in-up">
          <div class="divider" style="margin-bottom: var(--space-lg);"></div>
          <h2>Our <span class="gradient-text">Mission</span></h2>
          <p style="margin-top: var(--space-md); font-size: 1.15rem;">
            We exist to make world-class coaching accessible at organizational scale.
            Too many companies treat coaching as a perk for the few — we make it
            infrastructure for the many.
          </p>
          <p style="margin-top: var(--space-md);">
            By combining a deep network of 500+ ICF-certified coaches with
            technology-driven matching and analytics, we deploy coaching programs
            that move the needle on the metrics that matter: retention, engagement,
            promotion velocity, and leadership effectiveness.
          </p>
        </div>
        <div class="mission__stats animate-fade-in-up stagger-2">
          <div class="mission__stat">
            <span class="mission__stat-number">500+</span>
            <span class="mission__stat-label">ICF-Certified Coaches</span>
          </div>
          <div class="mission__stat">
            <span class="mission__stat-number">14</span>
            <span class="mission__stat-label">Countries Covered</span>
          </div>
          <div class="mission__stat">
            <span class="mission__stat-number">50K+</span>
            <span class="mission__stat-label">Coaching Sessions Delivered</span>
          </div>
          <div class="mission__stat">
            <span class="mission__stat-number">95%</span>
            <span class="mission__stat-label">Client Renewal Rate</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="values section bg-noise" id="values-section" style="position: relative;">
    <div class="container" style="position: relative; z-index: 1;">
      <div style="text-align: center; margin-bottom: var(--space-3xl);">
        <span class="badge animate-fade-in-up">Why Dragon Team</span>
        <h2 class="animate-fade-in-up stagger-1" style="margin-top: var(--space-md);">What Sets Us <span class="gradient-text">Apart</span></h2>
      </div>
      <div class="values__grid">
        {values.map((v, i) => (
          <div class={`card values__card animate-fade-in-up stagger-${i + 1}`}>
            <h3>{v.title}</h3>
            <p>{v.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Leadership -->
  <section class="team section" id="team-section">
    <div class="container">
      <div style="text-align: center; margin-bottom: var(--space-3xl);">
        <span class="badge animate-fade-in-up">Leadership</span>
        <h2 class="animate-fade-in-up stagger-1" style="margin-top: var(--space-md);">Meet the <span class="gradient-text">Team</span></h2>
      </div>
      <div class="team__grid">
        {leadership.map((person, i) => (
          <div class={`team__member animate-fade-in-up stagger-${i + 1}`} id={`team-member-${i}`}>
            <div class="team__avatar">{person.initials}</div>
            <h3 class="team__name">{person.name}</h3>
            <p class="team__role">{person.role}</p>
            <p class="team__bio">{person.bio}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- DD Connection -->
  <section class="connection section" id="dd-connection">
    <div class="container">
      <div class="connection__card animate-fade-in-up">
        <h2>Powered by <span class="gradient-text">Dancing Dragons</span></h2>
        <p>
          Dragon Team is an extension of <a href="https://dancingdragons.cc" target="_blank" style="color: var(--dt-gold);">Dancing Dragons CC</a> —
          the full-spectrum coaching platform that connects individuals with certified coaches.
          While Dancing Dragons serves individual clients, Dragon Team focuses exclusively on
          enterprise partnerships and corporate coaching programs.
        </p>
        <div class="connection__actions" style="margin-top: var(--space-xl);">
          <a href="https://dancingdragons.cc" target="_blank" class="btn btn--secondary">Visit Dancing Dragons ↗</a>
          <a href="/partners" class="btn btn--primary">Become a Partner</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>


<style>
  .page-hero {
    text-align: center;
    padding-bottom: var(--space-3xl);
  }
  .page-hero h1 { margin-top: var(--space-md); margin-bottom: var(--space-lg); }
  .page-hero__desc { max-width: 650px; margin: 0 auto; font-size: 1.15rem; }

  .mission__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4xl);
    align-items: center;
  }
  .mission__stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
  }
  .mission__stat {
    padding: var(--space-xl);
    background: var(--dt-surface);
    border: 1px solid var(--dt-border);
    border-radius: var(--radius-lg);
    text-align: center;
  }
  .mission__stat-number {
    font-size: 2rem;
    font-weight: 800;
    color: var(--dt-gold);
    display: block;
  }
  .mission__stat-label {
    font-size: 0.8rem;
    color: var(--dt-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-top: 4px;
    display: block;
  }

  .values__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-xl);
  }
  .values__card h3 { margin-bottom: var(--space-sm); font-size: 1.15rem; }
  .values__card p { font-size: 0.9rem; }

  .team__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-xl);
  }
  .team__member { text-align: center; }
  .team__avatar {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--dt-gold-dark), var(--dt-gold-light));
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 1.2rem;
    color: var(--dt-black);
    margin: 0 auto var(--space-lg);
    box-shadow: 0 4px 20px rgba(212, 168, 83, 0.2);
  }
  .team__name { font-size: 1.1rem; margin-bottom: 2px; }
  .team__role { font-size: 0.8rem; color: var(--dt-gold); font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: var(--space-sm); }
  .team__bio { font-size: 0.85rem; color: var(--dt-text-muted); }

  .connection__card {
    text-align: center;
    padding: var(--space-3xl);
    background: var(--dt-surface);
    border: 1px solid var(--dt-border);
    border-radius: var(--radius-xl);
    max-width: 700px;
    margin: 0 auto;
  }
  .connection__card h2 { margin-bottom: var(--space-lg); }
  .connection__card p { font-size: 1rem; }
  .connection__actions { display: flex; gap: var(--space-md); justify-content: center; flex-wrap: wrap; }

  @media (max-width: 768px) {
    .mission__grid { grid-template-columns: 1fr; }
    .team__grid { grid-template-columns: repeat(2, 1fr); }
    .values__grid { grid-template-columns: 1fr; }
  }
</style>
