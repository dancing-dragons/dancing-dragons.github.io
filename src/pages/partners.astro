---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';

const deals = [
  {
    id: "eap",
    tag: "EAP Integration",
    tagVariant: "green",
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
    name: "Employee Wellbeing Program",
    desc: "Embed Dragon Team coaching inside your Employee Assistance Program. Employees get same-week access to ICF-certified coaches for burnout prevention, leadership transitions, work-life balance, and personal growth — confidential, measurable, and fully integrated with your existing benefits infrastructure.",
    features: ["Access within 24–48 hours of request", "Aggregate outcomes & utilization dashboards", "Integrates with existing benefits portal", "Per-seat or per-engagement pricing"],
    cta: "Explore EAP Integration",
  },
  {
    id: "embedded",
    tag: "Most Common",
    tagVariant: "featured",
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>`,
    name: "Embedded Coaching Teams",
    desc: "We deploy a dedicated squad of 10 to 100+ coaches directly into your organization — aligned to your competency frameworks, integrated with your HRIS, and managed by a Dragon Team program director. A turnkey coaching department without the overhead. Scalable globally, active in under three weeks.",
    features: ["20–100+ coaches matched to your org", "Dedicated program manager included", "Custom competency framework alignment", "Real-time analytics & quarterly board reporting"],
    cta: "Deploy a Coaching Team",
    primary: true,
  },
  {
    id: "whitelabel",
    tag: "White Label",
    tagVariant: "magenta",
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>`,
    name: "White-Label Platform",
    desc: "Offer a fully branded coaching product to your clients or employees — powered by Dragon Team's coach network, infrastructure, and measurement framework. Your logo, your domain, your client relationship. Ideal for HR tech platforms, insurance providers, benefits administrators, and management consultancies.",
    features: ["Full custom branding & white-label portal", "API-first integration with your platform", "Coach credentialing & QA managed by us", "Revenue share or software licensing model"],
    cta: "Explore White Label",
  },
  {
    id: "referral",
    tag: "Channel Partner",
    tagVariant: "magenta",
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 12v8a2 2 0 002 2h12a2 2 0 002-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg>`,
    name: "Referral & Reseller Network",
    desc: "Join our partner network as a strategic referral source or certified reseller. Consulting firms, executive search agencies, and HR advisory practices earn competitive commissions on every client placed with Dragon Team. Resellers can bundle our coaching services directly into their own service packages at wholesale rates.",
    features: ["Tiered commission structure (10–20%)", "Co-branded proposals & pitch decks", "Dedicated partner success manager", "Joint go-to-market & co-marketing support"],
    cta: "Join the Network",
  },
];

const benefits = [
  { title: "Transparent Economics", desc: "Competitive partner revenue models — performance-based, milestone-tied, and fully transparent from day one." },
  { title: "Co-Marketing Support", desc: "Joint case studies, thought leadership content, webinars, and event sponsorships to grow your pipeline together." },
  { title: "Platform Access", desc: "Full access to our coach matching system, engagement analytics, and partner dashboard from day one of activation." },
  { title: "Credential Support", desc: "Your coaches receive ongoing professional development, ICF credential pathways, and continuing education credits." },
];
---

<BaseLayout title="Partnership Models" description="Four ways to partner with Dragon Team: EAP integration, embedded coaching teams, white-label platform, and referral network. Built for measurable enterprise impact.">

  <section class="page-hero section--hero bg-grid bg-radial" id="partners-hero">
    <div class="container">
      <span class="badge animate-fade-in-up">Partnership Models</span>
      <h1 class="animate-fade-in-up stagger-1">Four Ways to <span class="gradient-text">Partner With Us</span></h1>
      <p class="page-hero__desc animate-fade-in-up stagger-2">
        Every organization is different. Whether you need coaching embedded in your EAP, 
        a dedicated coaching squad, a white-label product, or a revenue-sharing referral arrangement — 
        we have a structure that fits.
      </p>
    </div>
  </section>

  <!-- Deal Types -->
  <section class="deals section" id="partnership-deals">
    <div class="container">
      <div class="deals__grid">
        {deals.map((deal, i) => (
          <div class={`deals__card animate-fade-in-up stagger-${i + 1}`} id={`deal-${deal.id}`}>
            <div class="deals__card-top">
              <div class={`deals__icon deals__icon--${deal.tagVariant === 'magenta' ? 'magenta' : 'green'}`} set:html={deal.icon} />
              <span class={`deals__tag deals__tag--${deal.tagVariant}`}>{deal.tag}</span>
            </div>
            <h2 class="deals__name">{deal.name}</h2>
            <p class="deals__desc">{deal.desc}</p>
            <ul class="deals__features">
              {deal.features.map(f => <li>{f}</li>)}
            </ul>
            <a href="/contact" class={`btn ${deal.primary ? 'btn--primary' : 'btn--secondary'} deals__cta`}>{deal.cta} →</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Benefits -->
  <section class="benefits section bg-noise" id="partner-benefits" style="position: relative;">
    <div class="container" style="position: relative; z-index: 1;">
      <div style="text-align: center; margin-bottom: var(--space-3xl);">
        <span class="badge animate-fade-in-up">Partner Benefits</span>
        <h2 class="animate-fade-in-up stagger-1" style="margin-top: var(--space-md);">Why Partners Choose <span class="gradient-text">Dragon Team</span></h2>
      </div>
      <div class="benefits__grid">
        {benefits.map((b, i) => (
          <div class={`card benefits__card animate-fade-in-up stagger-${i + 1}`}>
            <h3>{b.title}</h3>
            <p>{b.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="cta section bg-radial" id="partners-cta">
    <div class="container" style="text-align: center;">
      <h2>Ready to <span class="gradient-text">Partner?</span></h2>
      <p style="max-width: 540px; margin: var(--space-md) auto var(--space-2xl);">
        Tell us about your organization and the coaching challenge you're trying to solve.
        We'll identify the right partnership structure together.
      </p>
      <div style="display: flex; gap: var(--space-md); justify-content: center; flex-wrap: wrap;">
        <a href="/contact" class="btn btn--primary btn--large" id="partners-cta-btn">Apply for Partnership</a>
        <a href="/services" class="btn btn--secondary btn--large" id="partners-services-btn">Explore Our Services</a>
      </div>
    </div>
  </section>
</BaseLayout>


<style>
  .page-hero { text-align: center; padding-bottom: var(--space-3xl); }
  .page-hero h1 { margin-top: var(--space-md); margin-bottom: var(--space-lg); }
  .page-hero__desc { max-width: 660px; margin: 0 auto; font-size: 1.15rem; }

  .deals__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-xl);
  }

  .deals__card {
    background: var(--dt-surface);
    border: 1px solid var(--dt-border);
    border-radius: var(--radius-lg);
    padding: var(--space-2xl);
    display: flex;
    flex-direction: column;
    transition: all var(--duration-normal) var(--ease-out);
  }

  .deals__card:hover {
    border-color: var(--dt-border-active);
    box-shadow: var(--shadow-glow);
    transform: translateY(-4px);
  }

  .deals__card:has(.deals__icon--magenta):hover {
    border-color: rgba(224, 64, 251, 0.3);
    box-shadow: var(--shadow-magenta);
  }

  .deals__card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: var(--space-lg);
  }

  .deals__icon {
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
    border: 1px solid;
    flex-shrink: 0;
  }

  .deals__icon--green {
    background: var(--dt-green-glow);
    color: var(--dt-green);
    border-color: var(--dt-green-border);
  }

  .deals__icon--magenta {
    background: var(--dt-magenta-glow);
    color: var(--dt-magenta);
    border-color: rgba(224, 64, 251, 0.2);
  }

  .deals__tag {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 4px 12px;
    border-radius: var(--radius-full);
  }

  .deals__tag--green {
    background: var(--dt-green-glow);
    color: var(--dt-green);
    border: 1px solid var(--dt-green-border);
  }

  .deals__tag--featured {
    background: rgba(34, 197, 94, 0.2);
    color: var(--dt-green-light);
    border: 1px solid rgba(34, 197, 94, 0.4);
  }

  .deals__tag--magenta {
    background: var(--dt-magenta-glow);
    color: var(--dt-magenta);
    border: 1px solid rgba(224, 64, 251, 0.2);
  }

  .deals__name {
    font-size: 1.35rem;
    margin-bottom: var(--space-sm);
    color: var(--dt-text-primary);
  }

  .deals__desc {
    font-size: 0.92rem;
    margin-bottom: var(--space-lg);
    line-height: 1.75;
    flex-grow: 1;
  }

  .deals__features {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: var(--space-xl);
  }

  .deals__features li {
    font-size: 0.87rem;
    color: var(--dt-text-secondary);
    padding-left: 1.4rem;
    position: relative;
  }

  .deals__features li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--dt-green);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .deals__cta {
    align-self: flex-start;
    margin-top: auto;
    font-size: 0.9rem;
  }

  .benefits__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-xl);
  }

  .benefits__card h3 { margin-bottom: var(--space-sm); font-size: 1.15rem; }
  .benefits__card p { font-size: 0.9rem; }

  @media (max-width: 768px) {
    .deals__grid { grid-template-columns: 1fr; }
    .benefits__grid { grid-template-columns: 1fr; }
    .deals__card-top { flex-direction: column; gap: var(--space-sm); }
  }
</style>
