---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';

const services = [
  {
    title: "Executive Coaching",
    desc: "Dedicated one-on-one coaching for C-suite executives, VPs, and senior directors. Our ICF-PCC and MCC certified coaches deliver measurable leadership impact.",
    features: ["360° leadership assessments", "Customized development roadmaps", "Stakeholder interview integration", "Quarterly business impact reviews", "Confidential executive sounding board"],
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>`,
    scale: "1–10 leaders",
  },
  {
    title: "Team Coaching at Scale",
    desc: "Deploy coaching teams of 20 to 100+ certified coaches into your organization within weeks. Designed for companies undergoing rapid growth or transformation.",
    features: ["AI-powered coach-coachee matching", "Centralized engagement dashboard", "Standardized coaching methodologies", "Real-time progress analytics", "Dedicated program manager"],
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>`,
    scale: "20–100+ coaches",
  },
  {
    title: "Leadership Development Programs",
    desc: "Custom curriculum for emerging and mid-level leaders. Cohort-based programs that build leadership pipelines and accelerate succession planning.",
    features: ["Custom competency frameworks", "Cohort-based learning journeys", "Peer coaching circles", "Action learning projects", "Certification pathways"],
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 3h6a4 4 0 014 4v14a3 3 0 00-3-3H2zM22 3h-6a4 4 0 00-4 4v14a3 3 0 013-3h7z"/></svg>`,
    scale: "10–500 participants",
  },
  {
    title: "Change & Transformation Coaching",
    desc: "Navigate M&A integration, restructuring, digital transformation, and culture shifts with embedded coaching support that reduces resistance.",
    features: ["Transition readiness assessments", "Cultural integration support", "Stake­holder alignment coaching", "Resilience workshops", "Post-merger team building"],
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg>`,
    scale: "Organization-wide",
  },
  {
    title: "DEI & Inclusive Leadership",
    desc: "Build truly inclusive cultures with coaching programs that develop equitable leadership competencies at every level of your organization.",
    features: ["Inclusive leadership assessments", "Bias awareness coaching", "ERG leader development", "Allyship programs", "Inclusive team dynamics"],
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>`,
    scale: "All levels",
  },
  {
    title: "Wellness & Performance",
    desc: "Holistic coaching programs that address burnout prevention, work-life integration, and peak performance for high-demand roles.",
    features: ["Burnout risk assessments", "Stress management coaching", "Energy management systems", "Mindfulness integration", "Performance recovery plans"],
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>`,
    scale: "10–1000 individuals",
  },
  {
    title: "Team Coaching",
    desc: "Structured coaching for intact teams within your organization. Build trust, improve collaboration, and develop collective leadership capacity for sustained high performance.",
    features: ["Team diagnostics & assessments", "Alignment workshops", "Ongoing bi-weekly coaching cadence", "Peer accountability structures", "Psychological safety development"],
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="9" cy="7" r="4"/><path d="M3 21v-2a4 4 0 014-4h4a4 4 0 014 4v2"/><circle cx="19" cy="10" r="2.5"/><path d="M19 15a3 3 0 013 3v1"/></svg>`,
    scale: "4–25 members per team",
  },
  {
    title: "Nonprofit & Social Impact Coaching",
    desc: "Mission-aligned coaching for nonprofit executives, NGO teams, foundations, and social enterprises navigating growth, funding transitions, and scaling impact on limited budgets.",
    features: ["Board governance navigation", "Donor relationship coaching", "Staff burnout prevention", "Strategic planning alignment", "Succession & leadership transitions"],
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="M12 6v6l4 2"/><path d="M16 16l-4-2"/></svg>`,
    scale: "Organizations & teams",
  },
];
---

<BaseLayout title="Services" description="Enterprise coaching solutions — from executive one-on-one coaching to large-scale team deployments of 100+ coaches.">

  <section class="page-hero section--hero bg-grid bg-radial" id="services-hero">
    <div class="container">
      <span class="badge animate-fade-in-up">Our Solutions</span>
      <h1 class="animate-fade-in-up stagger-1">Enterprise Coaching<br/><span class="gradient-text">Built to Scale</span></h1>
      <p class="page-hero__desc animate-fade-in-up stagger-2">
        From C-suite executive coaching to deploying 100+ coaches across a global workforce —
        we design, staff, and manage coaching programs that deliver measurable business outcomes.
      </p>
    </div>
  </section>

  <section class="services-page section" id="services-list">
    <div class="container">
      {services.map((service, i) => (
        <div class={`svc-row animate-fade-in-up stagger-${(i % 4) + 1}`} id={`service-${i}`}>
          <div class="svc-row__icon" set:html={service.icon} />
          <div class="svc-row__body">
            <div class="svc-row__header">
              <h2>{service.title}</h2>
              <span class="svc-row__scale">{service.scale}</span>
            </div>
            <p>{service.desc}</p>
            <ul class="svc-row__features">
              {service.features.map(f => <li>{f}</li>)}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="cta section bg-radial" id="services-cta">
    <div class="container" style="text-align: center;">
      <h2>Need a Custom Solution?</h2>
      <p style="max-width: 500px; margin: var(--space-md) auto var(--space-2xl);">
        Every organization is different. Let's design a coaching program that fits your unique challenges.
      </p>
      <a href="/contact" class="btn btn--primary btn--large" id="services-cta-btn">Discuss Your Needs</a>
    </div>
  </section>
</BaseLayout>


<style>
  .page-hero {
    text-align: center;
    padding-bottom: var(--space-3xl);
  }

  .page-hero h1 {
    margin-top: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .page-hero__desc {
    max-width: 620px;
    margin: 0 auto;
    font-size: 1.15rem;
  }

  .svc-row {
    display: flex;
    gap: var(--space-2xl);
    padding: var(--space-2xl) 0;
    border-bottom: 1px solid var(--dt-border);
  }

  .svc-row:last-child {
    border-bottom: none;
  }

  .svc-row__icon {
    width: 56px;
    height: 56px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
    background: var(--dt-gold-glow);
    color: var(--dt-gold);
    border: 1px solid rgba(212, 168, 83, 0.15);
    margin-top: 4px;
  }

  .svc-row__header {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-sm);
    flex-wrap: wrap;
  }

  .svc-row__header h2 {
    font-size: 1.35rem;
  }

  .svc-row__scale {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--dt-gold);
    background: var(--dt-gold-glow);
    padding: 4px 10px;
    border-radius: var(--radius-full);
    border: 1px solid rgba(212, 168, 83, 0.15);
  }

  .svc-row__body p {
    margin-bottom: var(--space-md);
  }

  .svc-row__features {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-xl);
  }

  .svc-row__features li {
    font-size: 0.85rem;
    color: var(--dt-text-secondary);
    position: relative;
    padding-left: 1rem;
  }

  .svc-row__features li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--dt-gold);
    font-size: 0.75rem;
  }

  @media (max-width: 768px) {
    .svc-row {
      flex-direction: column;
      gap: var(--space-md);
    }
  }
</style>
